# Copier en .env — ce fichier est lu par docker compose. Ne jamais commiter .env.
GOOGLE_API_KEY=                 # clé Gemini AI Studio (gratuite) : https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.8-flash
PRODUCER_RATE_PER_SECOND=20
PRODUCER_FRAUD_RATIO=0.005        # 0.03 pour saturer volontairement ; attention au quota Gemini gratuit (1 enquête = 5-7 appels)
PRODUCER_CUSTOMERS=500
# --- Mode hybride GCP (optionnel) ---
USE_BIGQUERY=false
GCP_PROJECT_ID=
BQ_DATASET=fraudstream
GCP_SA_KEY_PATH=./gcp/.empty    # ./gcp/sa-key.json après `make gcp-setup`
# --- Ports exposés sur la machine hôte (plage 18xxx pour ne pas gêner d'autres stacks) ---
KAFKA_UI_PORT=18085
PRODUCER_PORT=18090
SPARK_UI_PORT=14040
AIRFLOW_PORT=18081
AGENTS_PORT=18800
